---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/albert-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { company } from '../data/site';
import { allLanguages, alternates, defaultLang, languages } from '../data/i18n';
import type { Copy, Lang } from '../data/copy-types';

interface Props {
  copy: Copy;
  /**
   * For any page other than the landing page: its own title and description,
   * and where it lives in each language (for canonical and hreflang).
   */
  page?: { title: string; description: string; paths: Record<Lang, string> };
}

const { copy, page } = Astro.props;
const meta = {
  title: page ? `${page.title} – ${company.shortName}` : copy.meta.title,
  description: page?.description ?? copy.meta.description,
};

const pathFor = (lang: Lang) => page?.paths[lang] ?? languages[lang].path;
const canonical = new URL(pathFor(copy.lang), Astro.site);
const others = alternates(copy.lang);

// One sharing image per language, 1200 × 630. See design/og-image.html.
const ogImage = new URL(`/og-${copy.lang}.png`, Astro.site);

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.legalName,
  alternateName: company.shortName,
  url: Astro.site?.href,
  email: company.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: company.city,
    addressCountry: 'AD',
  },
  description: copy.meta.description,
};
---

<!doctype html>
<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />

    {
      allLanguages.map((entry) => (
        <link
          rel="alternate"
          hreflang={entry.htmlLang}
          href={new URL(pathFor(entry.lang), Astro.site)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(pathFor(defaultLang), Astro.site)}
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={copy.ogLocale} />
    {
      others.map((other) => (
        <meta property="og:locale:alternate" content={other.ogLocale} />
      ))
    }
    <meta property="og:site_name" content={company.legalName} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={copy.meta.ogImageAlt} />

    <meta name="theme-color" content="#0a1428" />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(organisation)}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
