---
import Wordmark from './Wordmark.astro';
import type { Copy } from '../data/copy-types';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const { company: companyCopy, sections } = copy;
---

<section class="company full-rule" id={sections.company}>
  <div class="page">
    <div class="company__inner ruled">
      <div>
        <h2 class="company__title">{companyCopy.title}</h2>
        <p class="lead company__body">{companyCopy.body}</p>
        {/* Decorative lockup, hidden from assistive technology: the company
            name is already in the heading and the header. */}
        <div class="company__mark" aria-hidden="true">
          <Wordmark large />
        </div>
      </div>

      <dl class="facts">
        {
          companyCopy.rows.map((row) => (
            <div class="facts__row">
              <dt>{row.label}</dt>
              <dd class:list={[{ 'facts__value--mono': row.mono }]}>{row.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .company__inner {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 64px;
    align-items: start;
    padding-bottom: calc(var(--section-y) + 4px);
  }

  /* Newlines written in `company.body` render as line breaks; everything else
     wraps as usual. One `\n` starts a new line, two leave a blank line. */
  .company__body {
    white-space: pre-line;
  }

  .company__title {
    font-weight: 700;
    font-size: var(--t-h2-sm);
    margin-bottom: 12px;
  }

  /* Fills the space the short intro leaves beside the facts list. Purely
     decorative, so it goes away once the columns stack. */
  .company__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 52px;
  }

  .facts {
    margin: 0;
    font-size: var(--t-sm);
  }

  .facts__row {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 0 24px;
    border-bottom: 1px solid var(--c-rule);
  }

  .facts__row:last-child {
    border-bottom: 0;
  }

  .facts dt {
    color: var(--c-text-3);
    padding-block: 11px;
  }

  .facts dd {
    color: var(--c-text);
    margin: 0;
    padding-block: 11px;
  }

  .facts__value--mono {
    font-family: var(--font-mono);
    font-size: 0.84375rem;
  }

  @media (max-width: 860px) {
    .company__inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .company__mark {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .facts__row {
      grid-template-columns: 1fr;
      gap: 0;
      padding-block: 8px;
    }

    .facts dt {
      padding-block: 0;
    }

    .facts dd {
      padding-block: 2px 0;
    }
  }
</style>
