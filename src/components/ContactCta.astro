---
import { company } from '../data/site';
import type { Copy } from '../data/copy-types';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const { contact, sections } = copy;
---

<section class="contact" id={sections.contact}>
  <div class="page">
    <div class="contact__inner ruled">
      <h2 class="contact__title">{contact.title}</h2>
      <p class="contact__body">{contact.body}</p>
      <a class="btn" href={`mailto:${company.email}`}>{contact.cta}</a>
    </div>
  </div>
</section>

<style>
  .contact__inner {
    max-width: 780px;
    padding-block: calc(var(--section-y) + 4px) calc(var(--section-y) + 16px);
  }

  .contact__title {
    font-weight: 800;
    font-size: var(--t-h2-lg);
    letter-spacing: -0.02em;
    line-height: 1.08;
    margin-bottom: 16px;
  }

  .contact__body {
    color: var(--c-text-2);
    font-size: 1.03125rem;
    max-width: 560px;
    margin-bottom: 28px;
  }
</style>
