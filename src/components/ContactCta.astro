---
import { company } from '../data/site';
import type { Copy } from '../data/copy-types';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const { contact, sections } = copy;
---

<section class="contact full-rule" id={sections.contact}>
  <div class="page">
    <div class="contact__inner ruled">
      <h2 class="contact__title">{contact.title}</h2>
      <p class="contact__body">{contact.body}</p>
      <div class="contact__actions">
        <a class="btn" href={`mailto:${company.email}`}>{contact.cta}</a>
        <p class="contact__email">
          {contact.emailLead}{' '}
          <a href={`mailto:${company.email}`}>{company.email}</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact__inner {
    max-width: 780px;
    padding-block: calc(var(--section-y) + 4px) calc(var(--section-y) + 16px);
  }

  .contact__title {
    font-weight: 800;
    font-size: var(--t-h2-lg);
    letter-spacing: -0.02em;
    line-height: 1.08;
    margin-bottom: 16px;
  }

  .contact__body {
    color: var(--c-text-2);
    font-size: 1.03125rem;
    max-width: 560px;
    margin-bottom: 28px;
  }

  .contact__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 22px;
  }

  /* The address written out, for anyone whose browser has no mail app to hand
     the button to: it can be read, selected and copied. */
  .contact__email {
    color: var(--c-text-2);
    font-size: var(--t-sm);
  }

  .contact__email a {
    color: var(--c-text);
    border-bottom: 1px solid var(--c-rule-strong);
    padding-bottom: 2px;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .contact__email a:hover {
    color: var(--c-gold-soft);
    border-bottom-color: var(--c-gold-line);
  }
</style>
