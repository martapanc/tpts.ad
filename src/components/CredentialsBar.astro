---
import type { Copy } from '../data/copy-types';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const { credentials } = copy;
---

<div class="credentials">
  <div class="page">
    <ul class="credentials__list">
      {
        credentials.map((item) => (
          <li>
            {item.pre}
            <b>{item.strong}</b>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .credentials {
    border-block: 1px solid var(--c-rule);
    background: var(--c-bg-sunk);
    padding-block: 20px;
  }

  .credentials__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px 44px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--t-xs);
    color: var(--c-text-3);
    text-align: center;
  }

  .credentials__list b {
    color: var(--c-text-2);
    font-weight: 600;
  }
</style>
