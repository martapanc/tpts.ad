---
import Wordmark from './Wordmark.astro';
import { company } from '../data/site';
import { allLanguages } from '../data/i18n';
import type { Copy, Lang } from '../data/copy-types';

interface Props {
  copy: Copy;
  /**
   * Set on any page other than the landing page: where this page lives in each
   * language. The language switch then leads to the same page, and the section
   * links lead back to the landing page instead of to anchors that aren't here.
   */
  paths?: Record<Lang, string>;
}

const { copy, paths } = Astro.props;
const { nav, a11y } = copy;
const navPrefix = paths ? copy.path : '';
---

<header class="header">
  <div class="header__inner page">
    <a class="brand" href={copy.path} aria-label={a11y.homeLink}>
      <Wordmark />
    </a>

    <div class="header__end">
      <div class="menu" id="site-nav">
        <nav class="nav" aria-label={a11y.mainNav}>
          {
            nav.map((item) => (
              <a
                href={item.href.startsWith('#') ? `${navPrefix}${item.href}` : item.href}
                class:list={[{ 'nav__link--accent': item.accent }]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="langs" role="group" aria-label={a11y.languageSwitch}>
          <span class="langs__options">
            {
              allLanguages.map((option) =>
                option.lang === copy.lang ? (
                  <span class="langs__current" lang={option.htmlLang} aria-current="true">
                    {option.nativeName}
                  </span>
                ) : (
                  <a href={paths?.[option.lang] ?? option.path} hreflang={option.htmlLang} lang={option.htmlLang}>
                    {option.nativeName}
                  </a>
                ),
              )
            }
          </span>
        </div>
      </div>

      <button
        class="burger"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        data-nav-toggle
        data-label-open={a11y.openMenu}
        data-label-close={a11y.closeMenu}
      >
        <span class="sr-only" data-nav-label>{a11y.openMenu}</span>
        <span class="burger__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.getElementById('site-nav');
  const label = document.querySelector<HTMLElement>('[data-nav-label]');

  // Labels come from the page's own copy file, so the menu speaks the page's
  // language rather than a hard-coded one.
  const labels = {
    open: toggle?.dataset.labelOpen ?? '',
    close: toggle?.dataset.labelClose ?? '',
  };

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('nav--open', open);
    if (label) label.textContent = open ? labels.close : labels.open;
  };

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // Following an in-page link should put the menu away again.
  nav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });

  // Highlight whichever section's nav link is currently in view: whichever
  // section covers the most visible area below the header. Area-based
  // rather than a fixed "activation line" so a short trailing section
  // (e.g. Contact, sitting right above the footer) can still win once it's
  // what's actually on screen, without needing a page-bottom special case.
  const header = document.querySelector<HTMLElement>('.header');
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav a[href^="#"]'));
  const sections = navLinks
    .map((link) => document.getElementById(link.getAttribute('href')!.slice(1)))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length) {
    const setActive = (id: string | null) => {
      for (const link of navLinks) {
        link.classList.toggle('nav__link--active', id !== null && link.getAttribute('href') === `#${id}`);
      }
    };

    const updateActive = () => {
      const viewTop = header?.getBoundingClientRect().height ?? 0;
      const viewBottom = window.innerHeight;

      let current: string | null = null;
      let bestOverlap = 0;
      for (const section of sections) {
        const rect = section.getBoundingClientRect();
        const overlap = Math.min(rect.bottom, viewBottom) - Math.max(rect.top, viewTop);
        if (overlap > bestOverlap) {
          bestOverlap = overlap;
          current = section.id;
        }
      }
      setActive(current);
    };

    let ticking = false;
    document.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          updateActive();
        });
      },
      { passive: true },
    );

    updateActive();
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--c-bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--header-h);
  }

  .brand {
    display: block;
  }

  .header__end {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: var(--t-sm);
    color: var(--c-text-2);
  }

  .nav a {
    transition: color 0.15s ease;
    white-space: nowrap;
  }

  .nav a:hover {
    color: var(--c-text);
  }

  .nav__link--accent {
    color: var(--c-gold-soft);
  }

  .nav__link--active {
    color: var(--c-gold-soft);
    text-decoration: underline;
    text-decoration-color: var(--c-gold-line);
    text-underline-offset: 6px;
  }

  .menu {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .langs {
    display: flex;
    white-space: nowrap;
    align-items: baseline;
    gap: 10px;
    padding-left: 24px;
    border-left: 1px solid var(--c-rule-strong);
    font-size: var(--t-xs);
    color: var(--c-text-3);
  }

  .langs__label {
    color: var(--c-text-2);
  }

  .langs__options {
    display: flex;
    gap: 6px;
  }

  .langs__options > * + *::before {
    content: '/';
    display: inline-block; /* keeps the link's underline off the slash */
    margin-right: 6px;
    color: var(--c-rule-strong);
  }

  .langs__current {
    color: var(--c-text);
    font-weight: 600;
  }

  .langs a {
    transition: color 0.15s ease;
    text-decoration: underline;
    text-decoration-color: var(--c-rule-strong);
    text-underline-offset: 4px;
  }

  .langs a:hover {
    color: var(--c-text);
  }

  .burger {
    display: none;
    background: none;
    border: 1px solid var(--c-rule-strong);
    border-radius: var(--radius-sm);
    padding: 10px;
    cursor: pointer;
  }

  .burger__bars,
  .burger__bars::before,
  .burger__bars::after {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--c-text);
    content: '';
  }

  .burger__bars::before {
    transform: translateY(-6px);
  }

  .burger__bars::after {
    transform: translateY(4.5px);
  }

  @media (max-width: 1100px) {
    .header__end {
      gap: 16px;
    }

    .burger {
      display: block;
    }

    .menu {
      position: absolute;
      inset: 100% 0 auto;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px var(--gutter) 20px;
      background: var(--c-bg);
      border-block: 1px solid var(--c-rule);
    }

    .nav--open {
      display: flex;
    }

    .nav {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .langs {
      padding: 18px 0 0;
      border-left: 0;
    }

    .nav a {
      padding: 14px 0;
      border-bottom: 1px solid var(--c-rule);
      font-size: var(--t-lead);
    }
  }
</style>
