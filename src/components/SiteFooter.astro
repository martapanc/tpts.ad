---
import Logo from './Logo.astro';
import { company } from '../data/site';
import type { Copy } from '../data/copy-types';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const { footer } = copy;
---

<footer class="footer">
  <div class="footer__inner page">
    <p class="footer__brand">
      <Logo size={24} surface="var(--c-bg-sunk)" />
      <span>{footer.copyright}</span>
    </p>

    <p class="footer__nrt">{company.nrt}</p>

    <ul class="footer__links">
      {
        footer.links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--c-rule);
    background: var(--c-bg-sunk);
    padding-block: 26px;
    font-size: var(--t-xxs);
    color: var(--c-text-3);
  }

  .footer__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px 32px;
    flex-wrap: wrap;
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer__nrt {
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .footer__links {
    display: flex;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__links a:hover {
    color: var(--c-text-2);
  }

  @media (max-width: 700px) {
    .footer__inner {
      justify-content: flex-start;
    }
  }
</style>
