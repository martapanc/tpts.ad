---
/**
 * The three-peaks mark. The centre peak is stroked in the surface colour so it
 * reads as an overlap — pass the surface it sits on so the notch stays invisible.
 */
interface Props {
  size?: number;
  /** Background the mark is drawn on, for the centre peak's knockout stroke. */
  surface?: string;
  class?: string;
}

const { size = 26, surface = 'var(--c-bg)', class: className } = Astro.props;
---

<svg
  viewBox="0 0 96 96"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <polygon points="2,80 22,44 42,80" fill="var(--c-peak-blue)"></polygon>
  <polygon points="52,80 76,34 94,80" fill="var(--c-peak-red)"></polygon>
  <polygon
    points="26,80 46,10 68,80"
    fill="var(--c-peak-gold)"
    stroke={surface}
    stroke-width="5"></polygon>
</svg>
