---
import type { Copy } from '../data/copy-types';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const { caseStudies } = copy;

/* Three finder patterns — the part that reads as "QR code" even this small —
   plus a fixed scattering of data modules. Not a real symbol, the same way the
   invoice figure below is not a real invoice: both are decorative samples of
   a product's own output. */
const qrFinders: [number, number][] = [
  [0, 0],
  [22, 0],
  [0, 22],
];
const qrModules: [number, number][] = [
  [9, 1], [12, 2], [9, 4], [15, 5], [10, 7], [18, 8], [13, 9], [9, 10],
  [20, 11], [11, 12], [16, 13], [22, 14], [9, 15], [14, 16], [19, 17],
  [10, 18], [17, 19], [12, 20], [21, 21], [9, 22], [15, 23], [11, 25],
  [18, 24], [13, 26], [20, 25],
];
---

<section class="case full-rule">
  <div class="page">
    {
      caseStudies.map((caseStudy, index) => {
        const { visual } = caseStudy;
        return (
          <div class:list={['case__inner ruled', { 'case__inner--divided': index > 0 }]}>
            <div class="case__text">
              <h2 class="case__title">{caseStudy.title}</h2>
              <p class="lead">{caseStudy.body}</p>
              <p class="muted case__note">{caseStudy.note}</p>
              {caseStudy.linkHref && (
                <a class="case__link" href={caseStudy.linkHref}>
                  {caseStudy.link} <span aria-hidden="true">→</span>
                </a>
              )}
            </div>

            {visual.kind === 'invoice' ? (
              <figure class="invoice" aria-hidden="true">
                <div class="invoice__head">
                  <b>{visual.brand}</b>
                  <span>{visual.number}</span>
                </div>
                {visual.lines.map((line) => (
                  <div class="invoice__row">
                    <span>{line.label}</span>
                    <span>{line.amount}</span>
                  </div>
                ))}
                <div class="invoice__total">
                  <span>{visual.totalLabel}</span>
                  <span>{visual.totalAmount}</span>
                </div>
              </figure>
            ) : (
              <figure class="label" aria-hidden="true">
                <svg class="label__qr" viewBox="0 0 29 29" xmlns="http://www.w3.org/2000/svg">
                  {qrFinders.map(([x, y]) => (
                    <>
                      <rect x={x} y={y} width="7" height="7" fill="currentColor" />
                      <rect x={x + 1} y={y + 1} width="5" height="5" fill="var(--c-paper)" />
                      <rect x={x + 2} y={y + 2} width="3" height="3" fill="currentColor" />
                    </>
                  ))}
                  {qrModules.map(([x, y]) => (
                    <rect x={x} y={y} width="1.4" height="1.4" fill="currentColor" />
                  ))}
                </svg>
                <div class="label__text">
                  <div class="label__tag">{visual.tag}</div>
                  <div class="label__name">{visual.name}</div>
                </div>
                <div class="label__org">{visual.org}</div>
              </figure>
            )}
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .case__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 64px;
    align-items: center;
  }

  .case__inner--divided {
    border-top: 1px solid var(--c-rule);
  }

  .case__text {
    max-width: 560px;
  }

  .case__title {
    font-weight: 700;
    font-size: var(--t-h2);
    margin-bottom: 12px;
  }

  .case__note {
    margin-block: 10px 18px;
  }

  .case__link {
    color: var(--c-gold-soft);
    font-size: var(--t-sm);
    border-bottom: 1px solid var(--c-gold-line);
    padding-bottom: 2px;
  }

  .invoice,
  .label {
    margin: 0;
    width: 260px;
    padding: 18px 20px;
    background: var(--c-paper);
    color: var(--c-paper-ink);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.6;
    box-shadow: 0 16px 40px -14px rgba(0, 0, 0, 0.5);
    transform: rotate(-1deg);
  }

  .invoice__head,
  .invoice__row,
  .invoice__total {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .invoice__head {
    border-bottom: 2px solid var(--c-gold);
    padding-bottom: 7px;
    margin-bottom: 8px;
  }

  .invoice__head b {
    font-family: var(--font-display);
    font-size: 13px;
    color: var(--c-gold);
  }

  .invoice__row {
    border-bottom: 1px solid var(--c-paper-rule);
    padding-block: 3px;
  }

  .invoice__total {
    border-top: 1.5px solid var(--c-paper-ink);
    padding-top: 5px;
    font-weight: 500;
  }

  /* Same card treatment as .invoice (paper, rotation, shadow) so the two read as
     a pair; the inside mirrors the product's real label layout - QR on the left,
     a bold monospace tag, the item name, a small mark in the corner. */
  .label {
    display: flex;
    align-items: center;
    gap: 14px;
    position: relative;
    min-height: 76px;
  }

  .label__qr {
    flex: 0 0 46px;
    width: 46px;
    height: 46px;
    color: var(--c-paper-ink);
  }

  .label__text {
    min-width: 0;
  }

  .label__tag {
    font-weight: 700;
    font-size: 13px;
    letter-spacing: -0.01em;
  }

  .label__name {
    color: var(--c-text-3);
    margin-top: 3px;
    font-size: 10px;
  }

  .label__org {
    position: absolute;
    right: 14px;
    bottom: 10px;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--c-paper-ink);
    opacity: 0.55;
  }

  @media (max-width: 860px) {
    .case__inner {
      grid-template-columns: 1fr;
      gap: 40px;
      justify-items: start;
    }
  }
</style>
