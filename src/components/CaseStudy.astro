---
import type { Copy } from '../data/copy-types';
import invoiceImage from '../assets/projects/flexinvoice-invoice.webp';
import labelImage from '../assets/projects/flextag-label.png';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const { caseStudies } = copy;

/* Both images are the products' own output, rendered from made-up data: an
   invoice from the FlexInvoice rendering engine and a 62 mm label from FlexTag's
   label renderer. Regenerate them from the products rather than editing them.

   They are served exactly as saved, through a plain <img>. Astro's <Image> would
   re-encode them as small lossy WebP, which turns the invoice's fine print to
   mush; lossless at several times the display size stays sharp and is still
   only about 50 KB. */
const images = {
  invoice: { src: invoiceImage, width: 400 },
  label: { src: labelImage, width: 348 },
};
---

<section class="case full-rule">
  <div class="page">
    {
      caseStudies.map((caseStudy, index) => {
        const { visual } = caseStudy;
        return (
          <div class:list={['case__inner ruled', { 'case__inner--divided': index > 0 }]}>
            <div class="case__text">
              <h2 class="case__title">{caseStudy.title}</h2>
              <p class="lead">{caseStudy.body}</p>
              <p class="muted case__note">{caseStudy.note}</p>
              {caseStudy.linkHref && (
                <a class="case__link" href={caseStudy.linkHref}>
                  {caseStudy.link} <span aria-hidden="true">→</span>
                </a>
              )}
            </div>

            <figure class:list={['shot', `shot--${visual.kind}`]}>
              <img
                class="shot__image"
                src={images[visual.kind].src.src}
                alt={visual.alt}
                width={images[visual.kind].width}
                height={Math.round(
                  (images[visual.kind].width * images[visual.kind].src.height) /
                    images[visual.kind].src.width,
                )}
                loading="lazy"
                decoding="async"
              />
              <figcaption class="shot__caption">{visual.caption}</figcaption>
            </figure>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .case__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 64px;
    align-items: center;
  }

  .case__inner--divided {
    border-top: 1px solid var(--c-rule);
  }

  .case__text {
    max-width: 560px;
  }

  .case__title {
    font-weight: 700;
    font-size: var(--t-h2);
    margin-bottom: 12px;
  }

  .case__note {
    margin-block: 10px 18px;
  }

  .case__link {
    color: var(--c-gold-soft);
    font-size: var(--t-sm);
    border-bottom: 1px solid var(--c-gold-line);
    padding-bottom: 2px;
  }

  .shot {
    margin: 0;
    min-width: 0;
    max-width: 100%;
  }

  /* Paper on a dark page: the shadow and the slight tilt are what keep a white
     rectangle from reading as a hole in the layout. */
  .shot__image {
    display: block;
    max-width: 100%;
    height: auto;
    background: #fff;
    border-radius: var(--radius-md);
    box-shadow: 0 16px 40px -14px rgba(0, 0, 0, 0.5);
    transform: rotate(-1deg);
  }

  .shot--invoice .shot__image {
    width: 400px;
  }

  .shot--label .shot__image {
    width: 348px;
  }

  .shot__caption {
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    color: var(--c-text-2);
  }

  @media (max-width: 860px) {
    .case__inner {
      grid-template-columns: 1fr;
      gap: 40px;
      justify-items: start;
    }
  }
</style>
